{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@sokoban/ui-core": ["../packages/ui-core/src/index.ts", "./packages/ui-core/src/index.ts"],
      "@sokoban/ui-core/*": ["../packages/ui-core/src/*", "./packages/ui-core/src/*"]
    }
  }
}
