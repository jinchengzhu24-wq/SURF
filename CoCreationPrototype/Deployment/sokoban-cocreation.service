[Unit]
Description=Sokoban Co-Creation Prototype
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/SURF/CoCreationPrototype/Backend
EnvironmentFile=/root/SURF/Backend/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/root/SURF/CoCreationPrototype/Backend/venv/bin/python -m uvicorn app:app --host 0.0.0.0 --port 8010
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
