# Unified Sokoban AI Study Platform environment configuration
# Copy to `.env` at the repository root (never commit real secrets).

# --- Logging & CORS ---
LOG_LEVEL=INFO
ALLOWED_ORIGINS=https://sokobanaidemo.top,https://www.sokobanaidemo.top,http://127.0.0.1:8000,http://localhost:8000

# --- Security & Storage ---
# Configure a strong random secret before deployment (default value triggers a startup warning).
TOKEN_SECRET=replace-with-a-long-random-production-secret
# Required for destructive dashboard delete endpoints (/verify-dashboard-password, /delete-online-match, /clear-matchmaking-records).
DASHBOARD_DELETE_PASSWORD=replace-with-dashboard-delete-password

# Storage & static asset directories (relative paths resolve from the working directory)
SOKOBAN_DATA_DIR=server/data
SOKOBAN_DB_PATH=server/data/sokoban.sqlite3
SOKOBAN_STATIC_DIR=web/dist
SOKOBAN_WEBGL_BUILD_DIR=WebGLBuild

# --- Public & WebGL URLs ---
COCREATION_PUBLIC_BASE_URL=https://sokobanaidemo.top/cocreation
COCREATION_WEBGL_BASE_URL=https://sokobanaidemo.top/game/

# --- DeepSeek (DG summary & level-plan blueprints ONLY; strictly isolated from co-creation) ---
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
PLAN_LLM_TIMEOUT_SECONDS=45.0
DG_LLM_TIMEOUT_SECONDS=20.0
LEVEL_PLAN_TIMEOUT_SECONDS=30.0

# --- Moonshot / Kimi (co-creation chat, binary discovery, proposals, translation ONLY) ---
# COCREATION_LLM_API_KEY also accepts KIMI_API_KEY or MOONSHOT_API_KEY as fallback aliases.
COCREATION_LLM_PROVIDER=kimi
COCREATION_LLM_API_KEY=your_kimi_api_key_here
COCREATION_LLM_BASE_URL=https://api.moonshot.cn/v1
COCREATION_LLM_MODEL=kimi-k2.6
COCREATION_LLM_TIMEOUT_SECONDS=120.0
COCREATION_LLM_INTERNAL_DEADLINE_SECONDS=116.0

# --- Operational Timers & Feature Flags ---
ONLINE_ROOM_TTL_SECONDS=1800.0
ROOM_REAPER_INTERVAL_SECONDS=60.0
SOKOBAN_REAPER_ENABLED=true
COCREATION_DEADLINE_SECONDS=1200
COCREATION_DEMO_TTL_SECONDS=86400
COCREATION_PLAY_TICKET_LIFETIME_SECONDS=300
COCREATION_INTERRUPTED_AFTER_SECONDS=1800
COCREATION_DRAFT_REGENERATION_PENDING_TIMEOUT_SECONDS=60
COCREATION_DRAFT_REGENERATION_CLAIMED_TIMEOUT_SECONDS=120
COCREATION_BINARY_DISCOVERY_ENABLED=true
